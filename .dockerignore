# The only docker build in this repo is the relay image (relay/Dockerfile,
# deployed via fly.toml). Exclude everything, then re-include exactly what
# the Dockerfile COPYs — keeps the upload context to a few MB instead of
# shipping .git/ and the docs/ game files (multiple GB) on every deploy.
*
!package.json
!package-lock.json
!relay
!src
!scripts/
scripts/*
!scripts/backup-account-database.ts
!scripts/link-t2-account.ts
!scripts/list-discord-users.ts
!scripts/set-account-role.ts
!scripts/backfill-demo-guids.ts
!scripts/backfill-demo-stats.ts
!scripts/backfill-player-profiles.ts
!scripts/merge-demo-guids.ts
!scripts/player-loadouts.ts
!scripts/lib/
scripts/lib/*
!scripts/lib/r2.ts
!scripts/lib/demoGuidInventory.ts
!scripts/lib/playerProfiles.ts
