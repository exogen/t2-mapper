# Tribes 2 account credentials.
# Only username and password are needed — run `npm run login` to download
# the certificate and encrypted key from the TribesNext auth server.
# The login script writes everything to .env.local automatically.
T2_ACCOUNT_NAME=
T2_ACCOUNT_PASSWORD=

# These are populated automatically by `npm run login`:
# T2_ACCOUNT_CERTIFICATE=
# T2_ACCOUNT_ENCRYPTED_KEY=

# Server addresses (defaults shown)
# T2_AUTH_SERVER=tribesnext.thyth.com:60659
# T2_MASTER_SERVER=master.tribesnext.com

# Relay WebSocket port (default: 8765)
# RELAY_PORT=8765

# Path to game assets (default: docs/base relative to relay/). In the Fly
# image this is a sparse git checkout that relay/syncAssets.ts refreshes at
# boot from ASSETS_REPO_URL/ASSETS_REPO_REF into ASSETS_REPO_DIR, limited to
# ASSETS_SPARSE_PATTERNS (comma-separated; default docs/base/**/*.dts — the
# shapes the CRC check reads).
# GAME_BASE_PATH=/data/t2-mapper/docs/base
# ASSETS_REPO_URL=https://github.com/exogen/t2-mapper.git
# ASSETS_REPO_REF=main
# ASSETS_REPO_DIR=/data/t2-mapper
# ASSETS_SPARSE_PATTERNS=docs/base/**/*.dts

# Path to manifest.json (default: public/manifest.json relative to project root)
# MANIFEST_PATH=/app/public/manifest.json

# Relay URL for the browser client (default: ws://localhost:8765)
# RELAY_URL=ws://localhost:8765

# Public base URL serving the demo bucket (index.json + .rec files).
# DEMOS_BASE_URL=https://demos.tribes2.online/demos

# Where the app looks for a demo's sidecars — <name>.rec.cast.json,
# <name>.rec.commentary.json, <name>.rec.commentary.mp3 — by the same
# names as in the bucket. Defaults to DEMOS_BASE_URL.
# CAST_BASE_URL=

# Local casts and commentary, for trying them out before uploading. The
# dev server serves this folder at CAST_BASE_URL (which defaults to
# /casts when only the folder is given; it must be a path, not
# another host); demos themselves still come from DEMOS_BASE_URL. Put
# <name>.rec.cast.json (headless-cast.ts writes it next to the .rec by
# default) and CastGenius's <name>.rec.commentary.json / .mp3 in it.
# Restart the dev server after changing this: env is inlined at start.
# LOCAL_CAST_DIR=demos

# Logging (comma-separated). Bare level sets global default; module:level
# pairs override specific modules. If only modules given, rest are silent.
# LOG_LEVEL=debug
# LOG_LEVEL=liveStreaming:debug,DebugSuspense:trace
# LOG_LEVEL=warn,liveStreaming:debug

# Demo recording (optional). When enabled, the relay reconnects at every
# mission cycle and records each mission of every watched server to its
# own Tribes 2 .rec demo file.
# DEMO_RECORD_ENABLED=1
# DEMO_DIR=/data/demos
# DEMO_MIN_FREE_BYTES=1073741824
# DEMO_MAX_BYTES=268435456
# DEMO_MIN_LENGTH_MS=30000
# DEMO_MIN_PLAYERS=2
# DEMO_UPLOAD_RETRY_MS=300000
# DEMO_SHUTDOWN_DRAIN_MS=8000

# Cloudflare R2 upload for finalized demos (all four required to enable;
# otherwise demos stay in DEMO_DIR).
# DEMO_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# DEMO_R2_BUCKET=t2-demos
# DEMO_R2_ACCESS_KEY_ID=
# DEMO_R2_SECRET_ACCESS_KEY=
# DEMO_R2_PREFIX=demos/

# Watched-address persistence for warm-booting sessions after a relay
# restart/deploy (unwritable path just disables the feature).
# WATCH_STATE_PATH=/data/watch-state.json

# How long watchers keep the end-of-match view (scoreboard, sounds, chat)
# before a recording-driven mission-cycle reconnect (default 5s).
# WATCH_CYCLE_LINGER_MS=5000

# Server patrol: MapGenius proactively joins and records matching servers
# (no watcher needed). Requires DEMO_RECORD_ENABLED. Patterns match the
# whole server name, case-insensitive, * wildcard (no * = exact match);
# JSON array or comma-separated.
# DEMO_PATROL_ENABLED=1
# DEMO_PATROL_SERVERS=["Ski Club - Slope *","| THE CUT | Back to Ymir"]
# Mission types to patrol (exact strings, case-insensitive; empty = all).
# Live values include: "Capture the Flag", "Capture the Flag (Practice)",
# "LCTF", "LakRabbit", "MA Duel MOD", "Team Rabbit 2", "Arena", "Construction".
# DEMO_PATROL_MISSION_TYPES=["Capture the Flag","Capture the Flag (Practice)","LCTF"]
# DEMO_PATROL_MIN_PLAYERS=2
# DEMO_PATROL_MAX_SESSIONS=3
# DEMO_PATROL_INTERVAL_MS=60000
