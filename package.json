{
  "name": "t2-mapper",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "author": "Brian Beck <exogen@gmail.com>",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.7.0",
  "scripts": {
    "accounts:backup": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/backup-account-database.ts",
    "accounts:link-t2": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/link-t2-account.ts",
    "accounts:list": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/list-discord-users.ts",
    "accounts:set-role": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/set-account-role.ts",
    "demos:checkpoints": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/generate-demo-checkpoints.ts",
    "demos:backfill-checkpoints": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/backfill-demo-checkpoints.ts",
    "demos:backfill-guids": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/backfill-demo-guids.ts",
    "demos:backfill-profiles": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/backfill-player-profiles.ts",
    "demos:backfill-stats": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/backfill-demo-stats.ts",
    "demos:merge-guids": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/merge-demo-guids.ts",
    "demos:player-loadouts": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/player-loadouts.ts",
    "demos:backup": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/backup-demo-bucket.ts",
    "demos:delete": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/delete-demos.ts",
    "demos:migrate": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/migrate-relay-demos.ts",
    "build:manifest": "tsx --tsconfig tsconfig.node.json scripts/generate-manifest.ts -o src/manifest.json",
    "build:parser": "peggy TorqueScript.pegjs -o generated/TorqueScript.js --format es",
    "cast:export-schema": "tsx --tsconfig tsconfig.node.json scripts/export-cast-schema.ts",
    "add-vl2": "tsx --tsconfig tsconfig.node.json scripts/add-vl2.ts",
    "build": "vite build",
    "copy-public": "cpy --dot 'public/*' '!(public/docs)' docs",
    "format": "prettier --write .",
    "lint": "eslint .",
    "login": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/t2-login.ts",
    "normalize-encoding": "tsx --tsconfig tsconfig.node.json scripts/normalize-encoding.ts",
    "postbuild": "npm run copy-public -- --dry-run && npm run copy-public",
    "prebuild": "rimraf --verbose -g 'docs/!(base)'",
    "preview": "vite preview",
    "relay:dev": "node --env-file-if-exists=.env.development.local --watch --import=tsx/esm relay/server.ts",
    "relay": "node --env-file-if-exists=.env.development.local --import=tsx/esm relay/server.ts",
    "serve:static": "tsx scripts/serve-static.ts",
    "server-list": "node --env-file-if-exists=.env.development.local --import=tsx/esm scripts/t2-server-list.ts",
    "start:both": "concurrently npm:start npm:relay:dev",
    "start": "vite dev --host --force",
    "test:watch": "vitest",
    "test": "vitest run",
    "typecheck": "tsc --build --noEmit"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.42",
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/lib-storage": "^3.1114.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@tanstack/react-query": "^5.105.0",
    "better-auth": "1.7.18",
    "better-call": "1.4.5",
    "better-sqlite3": "13.0.3",
    "ignore": "^7.0.14",
    "lodash.orderby": "^4.18.0",
    "match-sorter": "^8.3.0",
    "nipplejs": "^1.0.4",
    "nuqs": "^2.10.2",
    "openai": "^7.15.0",
    "picomatch": "^4.0.7",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "t2-demo-parser": "^7.2.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15",
    "tsx": "^4.23.13",
    "unzipper": "^0.12.5",
    "ws": "^8.22.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.39.4",
    "@inquirer/prompts": "^8.7.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "^5.0.6",
    "@types/lodash.orderby": "^4.6.9",
    "@types/node": "^24.12.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "cpy-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "express": "^5.2.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "peggy": "^5.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-glsl": "^0.3.1",
    "puppeteer": "^24.40.0",
    "rimraf": "^6.1.3",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "puppeteer@24.40.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
